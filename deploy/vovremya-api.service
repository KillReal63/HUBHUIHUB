[Unit]
Description=Vovremya SQLite API
After=network.target
[Service]
User=vovremya
Group=vovremya
ExecStart=/opt/vovremya/venv/bin/python /opt/vovremya/server.py
Environment=DATA_DIR=/var/lib/vovremya
Environment=APP_ORIGIN=https://144.31.166.231
StateDirectory=vovremya
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=128M
[Install]
WantedBy=multi-user.target
